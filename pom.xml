            <!--                    <dateFormat>MM-dd-yyyy@HH:mm:ss</dateFormat>-->
            <!--                </configuration>-->
            <!--            </plugin>-->
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

    </build>




</project>